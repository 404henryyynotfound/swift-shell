{
  "name": "swift-shell",
  "version": "1.0.0",
  "description": "SwiftShell — a small, dependency-free shell language with an offline package manager and the swift command suite",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "main": "src/index.js",
  "bin": {
    "swift": "bin/swift.js",
    "swiftshell": "bin/swiftshell.js"
  },
  "files": [
    "bin/",
    "src/",
    "test/",
    "examples/",
    "registry.json",
    "README.md",
    "LICENSE"
  ],
  "pkg": {
    "assets": [
      "registry.json",
      "README.md",
      "examples/*.shs"
    ],
    "targets": [
      "node22-linux-x64",
      "node22-linux-arm64",
      "node22-macos-x64",
      "node22-macos-arm64",
      "node22-win-x64",
      "node22-win-arm64"
    ]
  },
  "keywords": [
    "shell",
    "language",
    "interpreter",
    "cli",
    "scripting",
    "package-manager"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "for f in bin/*.js src/*.js test/*.test.js; do node --check \"$f\" || exit 1; done",
    "demo": "node bin/swift.js run examples/hello.shs",
    "registry:list": "node bin/swift.js registry"
  }
}
