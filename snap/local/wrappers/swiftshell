#!/bin/sh
# Strict-confinement wrapper for the SwiftShell `swiftshell` command.
BASE="$SNAP/opt/swift-shell"
export SWIFTSHELL_HOME="${SNAP_USER_COMMON:-$SNAP_USER_DATA}/.swift-shell"
export PATH="$SNAP/opt/node/bin:$SWIFTSHELL_HOME/bin:$PATH"
exec "$SNAP/opt/node/bin/node" "$BASE/bin/swiftshell.js" "$@"
